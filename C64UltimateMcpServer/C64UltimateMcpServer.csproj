<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
    <PackageReference Include="ModelContextProtocol.Extensions.Apps" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../C64UltimateClient/C64UltimateClient.csproj" />
    <ProjectReference Include="../C64BasicPrgGenerator/C64BasicPrgGenerator.csproj" />
    <ProjectReference Include="../C64AssemblyPrgGenerator/C64AssemblyPrgGenerator.csproj" />
  </ItemGroup>

  <!-- Include resource files in the output -->
  <ItemGroup>
    <Content Include="Resources/data/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Features/Ui/dist/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="Features/Ui/node_modules/**/*" />
    <None Remove="Features/Ui/node_modules/**/*" />
  </ItemGroup>

</Project>
