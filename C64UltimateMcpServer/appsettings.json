{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mcp": {
    "Artifacts": {
      "MaxEntries": 256,
      "MaxBytes": 16777216,
      "MaxArtifactBytes": 4194304,
      "Lifetime": "01:00:00"
    },
    "Tasks": {
      "Capacity": 256,
      "TerminalRetention": "00:30:00",
      "PollInterval": "00:00:00.250"
    },
    "Workflow": {
      "Capacity": 256,
      "ContinuationLifetime": "01:00:00",
      "MaxRounds": 8,
      "MaxSourceBytes": 1048576,
      "MaxGenerationRequestBytes": 65536,
      "SamplingMaxTokens": 4096,
      "MaxRootHints": 20
    },
    "LiveResources": {
      "PollInterval": "00:00:05",
      "ListenerQueueCapacity": 32
    },
    "Cache": {
      "DocumentationTimeToLive": "01:00:00"
    },
    "Apps": {
      "PreviewBytes": 256
    },
    "Notifications": {
      "LegacyLoggingEnabled": true,
      "LegacyLoggingInterval": "00:00:15",
      "CleanupTimeout": "00:00:05"
    },
    "Transport": {
      "EndpointPath": "/",
      "HealthPath": "/health",
      "SessionMode": "StatefulForInitializeClients",
      "IdleTimeout": "02:00:00",
      "MaxIdleSessionCount": 10000
    },
    "Server": {
      "Name": "C64 Ultimate MCP Server",
      "Version": "1.0.0",
      "Title": "MCP Server for Commodore 64 Ultimate",
      "Description": "A comprehensive MCP server for the Commodore 64 Ultimate with 45+ tools for device control, file management, and machine operations",
      "WebsiteUrl": "https://ultimate64.com/",
      "Icons": [
        {
          "Source": "https://upload.wikimedia.org/wikipedia/commons/2/23/Commodore_C%3D_logo.svg",
          "MimeType": "image/svg+xml",
          "Sizes": [
            "any"
          ],
          "Theme": "light"
        }
      ]
    },
    "OAuth": {
      "Enabled": false,
      "Authority": "",
      "Audience": "",
      "RequiredScopes": [
        "mcp:access"
      ],
      "ClockSkew": "00:00:30"
    }
  },
  "Ultimate": {
    "BaseUrl": "http://192.168.0.120",
    "NetworkPassword": null,
    "RequestTimeout": "00:00:30"
  },
  "Downloads": {
    "RequestTimeout": "00:01:40"
  }
}
